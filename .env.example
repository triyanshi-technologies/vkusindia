# Public origin used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://vkusindia.ru

# Sanity - from sanity.io/manage → your project.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only if the dataset is private: API → Tokens → add token with "Viewer" permission.
SANITY_API_READ_TOKEN=
# Same random string as the "Secret" of the Sanity webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Enquiry emails (SMTP). Gmail: smtp.gmail.com, 465, the Gmail address and a 16-character
# App Password (Google Account → Security → App passwords). Leave empty to only log submissions.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Inbox that receives enquiries; several addresses can be comma-separated.
MAIL_TO=
